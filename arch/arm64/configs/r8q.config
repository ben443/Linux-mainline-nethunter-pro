CONFIG_OVERLAY_FS=y

# Qualcomm PCIe, UFS & USB PHYs (Built-in so lspci enumerates at boot)
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_QCOM=y
