# Qualcomm Snapdragon SM8250 & Samsung Galaxy S20 FE 5G (r8q)
# Optimized for U-Boot + Kali NetHunter Rootfs on sda36
CONFIG_LOCALVERSION="-r8q-nethunter"

# SoC & Core Architecture
CONFIG_ARCH_QCOM=y
CONFIG_NR_CPUS=8
CONFIG_SCHED_CLUSTER=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_IOMMU=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM8250=y

# SM8250 Clocks & Pin Control (Built-in for early U-Boot handoff)
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM8250=y
CONFIG_PINCTRL_SM8250_LPASS_LPI=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_HFPLL=y
CONFIG_SM_GCC_8250=y
CONFIG_SM_DISPCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_SM_VIDEOCC_8250=y
CONFIG_SM_CAMCC_8250=y
CONFIG_CLK_GFM_LPASS_SM8250=y

# Qualcomm SoC IPC, DMA & Bus Infrastructure
CONFIG_QCOM_SCM=y
CONFIG_QCOM_TZMEM=y
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
CONFIG_QCOM_QSEECOM=y
CONFIG_QCOM_QSEECOM_UEFISECAPP=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_MPM=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_LLCC=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_GENI_SE=y
